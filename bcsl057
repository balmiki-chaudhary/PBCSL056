Step 2: JSP Page – machine.jsp
jsp
Copy code
<%@ page import="java.sql.*" %>
<!DOCTYPE html>
<html>
<head>
    <title>Machine List</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div id="menu">
    <a href="home.html">Home</a> |
    <a href="machine.jsp">Machine List</a> |
    <a href="feedback.html">Feedback</a>
</div>

<div id="content">
    <h2>Machine List</h2>

    <table border="1">
        <tr>
            <th>Model_no</th>
            <th>Processor</th>
            <th>RAM</th>
            <th>Cost</th>
        </tr>

        <%
            Class.forName("com.mysql.cj.jdbc.Driver");
            Connection con = DriverManager.getConnection(
                "jdbc:mysql://localhost:3306/MachineDB", "root", "password");

            Statement stmt = con.createStatement();
            ResultSet rs = stmt.executeQuery("SELECT * FROM Machine");

            while(rs.next()) {
        %>
        <tr>
            <td><%= rs.getString("model_no") %></td>
            <td><%= rs.getString("processor") %></td>
            <td><%= rs.getString("RAM") %></td>
            <td><%= rs.getInt("cost") %></td>
        </tr>
        <%
            }
            con.close();
        %>
    </table>
</div>

</body>
</html>
